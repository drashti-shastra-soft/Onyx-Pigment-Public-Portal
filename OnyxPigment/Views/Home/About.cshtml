@{
    ViewBag.Title = "About ONYX Pigment PVT. LTD. | Trusted Pigment Manufacturer in India";
    ViewBag.MetaDescription = "Learn about ONYX Pigment PVT. LTD., an ISO and Chemexcil certified pigment manufacturer in Panoli, Gujarat. Exporting industrial pigments worldwide.";
    ViewBag.MetaKeywords = "About ONYX Pigment PVT. LTD., Pigment Manufacturer Gujarat, Certified Pigment Company India, Industrial Pigment Supplier, Chemexcil Certified Pigments";
}

<section class="breadcrumbSection">
    <div class="arrow-animated-up">
        <span></span>
        <span></span>
        <span></span>
    </div>
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-6">
                    <div class="headingBar">
                        <p><a href="@Url.Action("index", "Home")">Home</a> <i class="fas fa-angle-right"></i> About </p>
                        <h2>Reliable & Consistent Pigment Solutions</h2>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="breadcrumbRight">
                        <img src="/images/icons/bottomtriangle.png" class="triangleBottom">
                        <img src="~/images/About.png" class="img-fluid" alt="About Us Image" loading="lazy" />

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="aboutInner section-gap">
    <img src="~/images/icons/bottomtriangle.png" class="triangleBottom">
   
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-7 col-xl-6">
                    <div class="AboutuseInnerLeft">
                        <ul class="nav nav-tabs" id="myTab" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="home-tab" data-toggle="tab" data-target="#AboutUs" type="button" role="tab" aria-controls="home" aria-selected="true"><i class="fas fa-bullseye"></i> Our Mission</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="profile-tab" data-toggle="tab" data-target="#Mission" type="button" role="tab" aria-controls="profile" aria-selected="false"><i class="far fa-eye"></i> Our Vision</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="contact-tab" data-toggle="tab" data-target="#Vision" type="button" role="tab" aria-controls="contact" aria-selected="false"><i class="fas fa-flag-checkered"></i>Our Goal</button>
                            </li>
                        </ul>
                        <div class="showAbout">
                            <div class="tab-content" id="myTabContent">
                                <div class="tab-pane fade show active" id="AboutUs" role="tabpanel" aria-labelledby="home-tab">
                                    <p>At ONYX Pigment, our mission is to deliver premium-quality pigments that empower industries with consistent color performance, sustainable production, and global competitiveness. We are committed to maintaining high standards in manufacturing, ensuring environmental responsibility, and building long-term partnerships based on trust and transparency.</p>
                                </div>

                                <div class="tab-pane fade" id="Mission" role="tabpanel" aria-labelledby="profile-tab">
                                    <p>Our vision is to become a globally recognized name in the pigment industry by innovating in color chemistry and expanding our footprint across international markets. We aspire to set new benchmarks in product excellence, sustainability, and customer satisfaction, while contributing to a colorful and eco-conscious future.</p>
                                </div>

                                <div class="tab-pane fade" id="Vision" role="tabpanel" aria-labelledby="contact-tab">
                                    <p>At ONYX Pigment, our primary goal is to maintain an unwavering commitment to quality by utilizing state-of-the-art manufacturing technology and adhering to stringent quality control standards. We aim to build long-term relationships with our customers by delivering reliable, high-performance pigments tailored to their specific requirements.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="certificationSections section-gap">
    <img src="~/images/icons/dots2.png" class="img-fluid FlotingDots" alt="Folating Dot" loading="lazy">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="headingBar" style="text-align: center;">
                        <p style="text-align: center;">Our Certifications</p>
                        <h2>Certified for Excellence</h2>
                    </div>
                </div>
            </div>
            <div class="row" id="CertificateROWFix">
                <div class="">
                    <div class="certifateArea">
                        <a href="~/images/certifications/ISO-Certificate.jpg" class="glightbox" data-gallery="gallery1">
                            <img src="~/images/certifications/ISO-Certificate.jpg" alt="ISO Certification" class="img-fluid" loading="lazy" />
                        </a>
                        <h3>ISO Certification</h3>
                    </div>
                </div>
                <div class="">
                    <div class="certifateArea">
                        <a href="~/images/certifications/Chemexcil.jpg" class="glightbox" data-gallery="gallery1">
                            <img src="~/images/certifications/Chemexcil.jpg" alt="Chemexcil Certification" class="img-fluid" loading="lazy" />
                        </a>
                        <h3>Chemexcil Certification</h3>
                    </div>
                </div>

                <div class="">
                    <div class="certifateArea">
                        <a href="~/images/certifications/IEC-Certificate.jpg" class="glightbox" data-gallery="gallery1">
                            <img src="~/images/certifications/IEC-Certificate.jpg" alt="IEC Certification" class="img-fluid" loading="lazy" />
                        </a>
                        <h3>IEC Certification</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

