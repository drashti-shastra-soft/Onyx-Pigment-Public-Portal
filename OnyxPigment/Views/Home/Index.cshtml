@{
    ViewBag.Title = "ONYX Pigment PVT. LTD. | Leading Pigment Manufacturer & Exporter in India";
    ViewBag.MetaDescription = "ONYX Pigment PVT. LTD. is a top pigment manufacturer in Gujarat, India. Supplying high-quality pigments globally at competitive prices. ISO & Chemexcil certified.";
    ViewBag.MetaKeywords = "ONYX Pigment PVT. LTD., Pigment Manufacturer India, Industrial Pigments Exporter, Organic Pigments Supplier, B2B Pigments, Gujarat Pigment Company";
}
@section HeadContent {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Organization",
          "name": "ONYX Pigment PVT. LTD.",
          "alternateName": "ONYX Pigment",
          "url": "https://onyxpigment.com/",
          "logo": "https://onyxpigment.com/images/OnyxFullLength.png",
          "description": "ONYX Pigment PVT. LTD. is a leading B2B manufacturer and global exporter of industrial pigments including Copper Phthalocyanine and Azo pigments, based in Panoli, Bharuch, Gujarat, India.",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "Plot No. 8/19 & 20, Opp. Sun Pharma, Panoli Industrial Estate",
            "addressLocality": "Panoli",
            "addressRegion": "Gujarat",
            "addressCountry": "IN",
            "postalCode": "394115"
          },
          "contactPoint": [
            {
              "@@type": "ContactPoint",
              "telephone": "+91-9000809700",
              "contactType": "Sales",
              "email": "sales@onyxpigment.com",
              "areaServed": "Worldwide",
              "availableLanguage": ["English", "Hindi"]
            },
            {
              "@@type": "ContactPoint",
              "telephone": "+91-9777772837",
              "contactType": "Customer Service",
              "email": "info@onyxpigment.com",
              "areaServed": "Worldwide",
              "availableLanguage": ["English", "Hindi"]
            },
            {
              "@@type": "ContactPoint",
              "telephone": "+91-9777772857",
              "contactType": "General Inquiry",
              "email": "vinod@onyxpigment.com",
              "areaServed": "Worldwide",
              "availableLanguage": ["English", "Hindi"]
            }
          ],
          "keywords": [
            "Pigment Manufacturer India",
            "Industrial Pigments Exporter",
            "Copper Phthalocyanine Pigments",
            "Azo Pigments Supplier",
            "B2B Pigment Company Gujarat"
          ]
        }
    </script>
}
<section class="HomeSlider">
    @* <img src="~/images/icons/bottomtriangle.png" class="triangleBottom" /> *@
    <div id="carouselExampleFade" class="carousel slide carousel-fade" data-ride="carousel">
        <ol class="carousel-indicators">
            <li data-target="#carouselExampleFade" data-slide-to="0" class="active"></li>
            <li data-target="#carouselExampleFade" data-slide-to="1"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/slider/OnyxPigmentEntrace.png" class="img-fluid w-100" alt="...">
                <div class="">
                </div>
                <div class="carousel-caption">
                    <h3>The Science of Color, The Art of Innovation!</h3>
                    <p>
                        Delivering High-Performance Pigments for Vibrant & Reliable Applications.
                    </p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/slider/Slider8.jpg" class="img-fluid w-100" alt="...">
                <div class="carousel-caption">
                    <h3>Color Beyond Limits.</h3>
                    <p>
                        Vibrant, stable pigments engineered for brilliance and performance.
                    </p>
                </div>
            </div>
            @* <div class="carousel-item">
                <img src="~/images/slider/Slider2.jpg" class="img-fluid w-100" alt="...">
                <div class="carousel-caption leftSideLayout">
                    <h3>Innovating Colors, Transforming Industries.</h3>
                    <p>
                        Engineered for Excellence in Textile, Plastic, Ink, and Coating Solutions.
                    </p>
                </div>
            </div> *@
        </div>
        <button class="carousel-control-prev" type="button" data-target="#carouselExampleFade" data-slide="prev">
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button class="carousel-control-next" type="button" data-target="#carouselExampleFade" data-slide="next">
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
    </div>
</section>
<section class="aboutusSection section-gap">
    <div class="WrapperContainer">
        <div class="container-fluid">
            <div class="row" id="alignSet">
                <div class="col-lg-4 col-md-12">
                    <div class="AboutImageSectiob">
                        <img src="~/images/icons/bottomtriangle.png" class="triangleBottom" />
                        <div class="ImageLayers hover-effect">
                            <img src="~/images/LiquidPool.jpg" class="img-fluid" alt="About ONYX Pigment" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="aboutRight">
                        <div class="headingBar">
                            <p>About Us</p>
                            <h2><label translate="no">ONYX Pigment</label>: A Legacy of Quality & Precision!</h2>
                        </div>
                        <div class="aboutRightInner">
                            <div class="">
                                <div class="ParagraphSection about-content">
                                    <p><span>At <label translate="no">ONYX Pigment</label>,</span> we manufacture Copper Phthalocyanine Green and Copper Phthalocyanine Blue, Azo Pigment Red and Azo Pigment Yellow delivering high-quality pigments for industries like coatings, plastics, textiles, and printing inks. With a focus on innovation, precision, and sustainability, we ensure consistent and reliable products that enhance performance and aesthetics.</p>
                                    <p><span>Our Mission: </span>Our mission is to be a leading manufacturer of high-performance pigments by combining innovation, sustainability, and advanced technology. We strive to provide our customers with eco-friendly, durable, and vibrant pigment solutions that enhance their products while ensuring minimal environmental impact.</p>
                                    <p><span>Our Vision: </span>To become a global leader in pigment manufacturing, known for quality, sustainability, and customer-centric solutions. We envision a future where <label translate="no">ONYX Pigment</label> sets the benchmark for excellence in the chemical industry, continuously innovating to meet the evolving needs of diverse industries worldwide.</p>
                                </div>
                                <div class="OnyxButton">
                                    <a href="@Url.Action("about", "Home")">Discover Our Journey<i class="fas fa-arrow-right"></i></a>
                                </div>
                            </div>
                            @* <div class="about-year">
                                <h3>Since</h3>
                                <h2 class="about-year-title">1998</h2>
                                <img src="~/images/icons/bottomtriangle.png" class="triangleBottom" />
                            </div> *@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
